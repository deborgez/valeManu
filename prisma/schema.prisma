generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  USER
}

enum ParteInteressada {
  LOCADOR
  LOCATARIO
  IMOBILIARIA
}

enum ManutencaoStatus {
  SOLICITACAO
  AGUARDANDO_ORCAMENTO
  AGUARDANDO_APROVACAO
  APROVADA
  AGENDADA
  EM_ANDAMENTO
  CONCLUIDA
}

enum PedidoOrcamentoStatus {
  AGUARDANDO_ENTREGA
  NAO_ENTREGUE
  ENTREGUE_AGUARDANDO_APROVACAO
  CONTRAOFERTA_ENVIADA
  APROVADO
  REPROVADO
}

enum PagamentoStatus {
  PENDENTE
  PAGO
}

enum AnexoTipo {
  FOTO
  VIDEO
  ORCAMENTO
}

enum InicioServicoTipo {
  IMEDIATO
  AGENDADO
}

enum InicioServicoStatus {
  AGENDADO
  INICIADO_ANDAMENTO
}

enum TipoFianca {
  FIADOR
  SEGURO_FIANCA
  FIANCA_ONEROSA
  TITULO_CAPITALIZACAO
  CAUCAO_IMOBILIARIA
  CAUCAO_DINHEIRO
  SEM_GARANTIA
}

enum FormaAviso {
  EMAIL
  WHATSAPP
  TERMO
}

enum FormaContato {
  LIGACAO
  WHATSAPP
}

model Imobiliaria {
  id        String   @id @default("singleton")
  nome      String
  endereco  String
  telefone  String
  email     String
  logoUrl   String?
  updatedAt DateTime @updatedAt
}

model User {
  id         String   @id @default(cuid())
  nome       String
  email      String   @unique
  senhaHash  String
  role       Role     @default(USER)
  unidade    String?
  createdAt  DateTime @default(now())

  manutencoesCriadas Manutencao[]      @relation("CriadoPor")
  pedidosGerados     PedidoOrcamento[] @relation("GeradoPor")
  processosCriados   Processo[]        @relation("ProcessoCriadoPor")
  distratosCriados   Distrato[]        @relation("DistratoCriadoPor")
}

model Prestador {
  id            String   @id @default(cuid())
  nome          String
  especialidade String
  telefone      String
  cpf           String?
  email         String?
  observacoes   String?
  createdAt     DateTime @default(now())

  pedidos PedidoOrcamento[]
}

model Manutencao {
  id                String           @id @default(cuid())
  numeroProcesso    String           @unique
  cep               String?
  rua               String?
  numero            String?
  complemento       String?
  bairro            String?
  cidade            String?
  estado            String?
  solicitanteTipo   ParteInteressada
  solicitanteNome   String?
  solicitanteCpf    String?
  natureza          String
  descricaoProblema String
  emergencial       Boolean          @default(false)
  competencia       ParteInteressada
  status            ManutencaoStatus @default(SOLICITACAO)
  reaberta          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  criadoPorId String
  criadoPor   User   @relation("CriadoPor", fields: [criadoPorId], references: [id])

  pedidosOrcamento  PedidoOrcamento[]
  inicioServicos    InicioServico[]
  conclusoesServico ConclusaoServico[]
  pagamentos        Pagamento[]
  historico         HistoricoEtapa[]
}

model PedidoOrcamento {
  id               String                @id @default(cuid())
  token            String                @unique @default(cuid())
  status           PedidoOrcamentoStatus @default(AGUARDANDO_ENTREGA)
  valorMaoDeObra   Float?
  valorMaterial    Float?
  descricaoServico String?
  createdAt        DateTime              @default(now())
  entregueEm       DateTime?

  contraOfertaValorMaoDeObra Float?
  contraOfertaValorMaterial  Float?
  contraOfertaObservacao     String?
  contraOfertaRecusada       Boolean @default(false)

  percentualAdministracao Float @default(15)

  manutencaoId String
  manutencao   Manutencao @relation(fields: [manutencaoId], references: [id])

  prestadorId String
  prestador   Prestador @relation(fields: [prestadorId], references: [id])

  geradoPorId String
  geradoPor   User   @relation("GeradoPor", fields: [geradoPorId], references: [id])

  anexos Anexo[]

  inicioServico InicioServico[]
}

model Anexo {
  id       String    @id @default(cuid())
  tipo     AnexoTipo
  path     String
  mimeType String
  filename String
  createdAt DateTime @default(now())

  pedidoOrcamentoId String?
  pedidoOrcamento   PedidoOrcamento? @relation(fields: [pedidoOrcamentoId], references: [id])

  conclusaoServicoId String?
  conclusaoServico   ConclusaoServico? @relation(fields: [conclusaoServicoId], references: [id])
}

model InicioServico {
  id                     String               @id @default(cuid())
  tipo                   InicioServicoTipo
  dataHoraAgendada       DateTime?
  status                 InicioServicoStatus
  createdAt              DateTime             @default(now())

  manutencaoId String
  manutencao   Manutencao @relation(fields: [manutencaoId], references: [id])

  pedidoOrcamentoAprovadoId String
  pedidoOrcamentoAprovado   PedidoOrcamento @relation(fields: [pedidoOrcamentoAprovadoId], references: [id])

  conclusao ConclusaoServico?
}

model ConclusaoServico {
  id             String   @id @default(cuid())
  dataConclusao  DateTime @default(now())
  observacoes    String?

  manutencaoId String
  manutencao   Manutencao @relation(fields: [manutencaoId], references: [id])

  inicioServicoId String?       @unique
  inicioServico   InicioServico? @relation(fields: [inicioServicoId], references: [id])

  anexos Anexo[]
}

model Pagamento {
  id               String          @id @default(cuid())
  status           PagamentoStatus @default(PENDENTE)
  valor            Float?
  dataPagamento    DateTime?
  comprovanteUrl   String?
  comprovanteNome  String?
  comprovanteTipo  String?
  createdAt        DateTime        @default(now())

  manutencaoId String
  manutencao   Manutencao @relation(fields: [manutencaoId], references: [id])
}

model HistoricoEtapa {
  id           String   @id @default(cuid())
  etapa        String
  detalhe      String?
  createdAt    DateTime @default(now())

  manutencaoId String
  manutencao   Manutencao @relation(fields: [manutencaoId], references: [id])
}

model Processo {
  id             String @id @default(cuid())
  numeroProcesso String @unique

  unidade     String?
  codigoImovel String?
  captador    String?

  prazoContratoInicio DateTime?
  prazoContratoMeses  Int?
  prazoContratoFim    DateTime?

  tipoFianca     TipoFianca?
  fiancaNome     String?
  fiancaTelefone String?
  fiancaRg       String?
  fiancaCpf      String?

  cep         String?
  rua         String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criadoPorId String
  criadoPor   User   @relation("ProcessoCriadoPor", fields: [criadoPorId], references: [id])

  partes    ParteProcesso[]
  distratos Distrato[]
}

model ParteProcesso {
  id       String           @id @default(cuid())
  tipo     ParteInteressada
  nome     String
  telefone String
  rg       String
  cpf      String

  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])
}

model Distrato {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  processoId String
  processo   Processo @relation(fields: [processoId], references: [id])

  criadoPorId String
  criadoPor   User   @relation("DistratoCriadoPor", fields: [criadoPorId], references: [id])

  avisoPrevio         AvisoPrevioLocatario?
  comunicadoLocador   ComunicadoLocador?
  contatos            ContatoAcompanhamento[]
  agendamentoVistoria AgendamentoVistoriaSaida?
  entregaChaves       EntregaChaves?
  vistoriaSaida       VistoriaSaida?
}

model AvisoPrevioLocatario {
  id            String     @id @default(cuid())
  data          DateTime
  forma         FormaAviso
  arquivoUrl    String?
  arquivoNome   String?
  arquivoTipo   String?
  diasForaPrazo Int?
  createdAt     DateTime   @default(now())

  distratoId String   @unique
  distrato   Distrato @relation(fields: [distratoId], references: [id])
}

model ComunicadoLocador {
  id            String     @id @default(cuid())
  data          DateTime
  forma         FormaAviso
  arquivoUrl    String?
  arquivoNome   String?
  arquivoTipo   String?
  diasForaPrazo Int?
  createdAt     DateTime   @default(now())

  distratoId String   @unique
  distrato   Distrato @relation(fields: [distratoId], references: [id])
}

model ContatoAcompanhamento {
  id          String       @id @default(cuid())
  data        DateTime     @default(now())
  forma       FormaContato
  arquivoUrl  String?
  arquivoNome String?
  arquivoTipo String?

  dataPrevistaEntregaChaves DateTime?
  dataPrevistaVistoriaSaida DateTime?

  distratoId String
  distrato   Distrato @relation(fields: [distratoId], references: [id])
}

model AgendamentoVistoriaSaida {
  id   String   @id @default(cuid())
  data DateTime

  comunicacaoData        DateTime?
  comunicacaoArquivoUrl  String?
  comunicacaoArquivoNome String?
  comunicacaoArquivoTipo String?

  locadorNaoQuerParticipar        Boolean @default(false)
  naoParticiparArquivoUrl  String?
  naoParticiparArquivoNome String?
  naoParticiparArquivoTipo String?

  createdAt DateTime @default(now())

  distratoId String   @unique
  distrato   Distrato @relation(fields: [distratoId], references: [id])
}

model EntregaChaves {
  id        String   @id @default(cuid())
  data      DateTime
  termoUrl  String?
  termoNome String?
  termoTipo String?

  informeData        DateTime?
  informeArquivoUrl  String?
  informeArquivoNome String?
  informeArquivoTipo String?

  createdAt DateTime @default(now())

  distratoId String   @unique
  distrato   Distrato @relation(fields: [distratoId], references: [id])
}

model VistoriaSaida {
  id          String   @id @default(cuid())
  data        DateTime
  arquivoUrl  String?
  arquivoNome String?
  arquivoTipo String?

  locadorCompareceu   Boolean?
  locatarioParticipou Boolean?

  informeData        DateTime?
  informeArquivoUrl  String?
  informeArquivoNome String?
  informeArquivoTipo String?

  dataEntregaLaudo DateTime?
  laudoArquivoUrl  String?
  laudoArquivoNome String?
  laudoArquivoTipo String?

  createdAt DateTime @default(now())

  distratoId String   @unique
  distrato   Distrato @relation(fields: [distratoId], references: [id])
}
